{
  "name": "max-support-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts api",
    "worker": "tsx src/main.ts worker",
    "gateway": "tsx src/main.ts gateway",
    "dev:all": "tsx src/main.ts all",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/postgres.test.ts",
    "db:migrate": "tsx src/cli.ts migrate",
    "admin:bootstrap": "tsx src/cli.ts bootstrap",
    "max:subscribe": "tsx src/cli.ts subscribe",
    "env:init": "node scripts/init-env.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1000.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@maxhub/max-bot-api": "0.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bullmq": "5.81.5",
    "dotenv": "16.6.1",
    "fastify": "5.12.5",
    "file-type": "21.3.4",
    "ioredis": "5.11.1",
    "lossless-json": "4.2.0",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "undici": "7.29.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
