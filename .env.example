# Local development only. Run npm run env:init to generate private local credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
APP_ORIGIN=http://localhost:5173
ORG_ID=00000000-0000-4000-8000-000000000001
ORG_NAME=Служба поддержки
ORG_TIMEZONE=Asia/Krasnoyarsk
DATABASE_URL=postgres://support:CHANGE_ME@localhost:55432/support
POSTGRES_PORT=55432
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
GATEWAY_SECRET=GENERATE_RANDOM_SECRET
GATEWAY_URL=http://localhost:3001
GATEWAY_PORT=3001
# mock never contacts customers. Set live only after configuring the real token.
MAX_MODE=mock
MAX_API_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=GENERATE_RANDOM_SECRET
MAX_MEDIA_HOSTS=
POLICY_VERSION=dev-1
POLICY_URL=https://example.invalid/privacy
ALTERNATIVE_CONTACT=Обратитесь в службу поддержки вашей организации.
# Feature flags keep human support operational without AI or memory.
AI_ENABLED=false
AI_MODE=mock
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
AI_MAX_CONCURRENCY=12
AI_TRIAGE_TIMEOUT_SECONDS=45
AI_LEARNING_TIMEOUT_SECONDS=90
AI_INPUT_CHARS=24000
MEMORY_ENABLED=false
AGENTMEMORY_URL=http://localhost:3111
AGENTMEMORY_SECRET=GENERATE_RANDOM_SECRET
STORAGE_MODE=local
STORAGE_PATH=.data/attachments
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=support-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SCANNER_MODE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
BOOTSTRAP_MAX_USER_ID=
BOOTSTRAP_NAME=Администратор
# Only explicit loopback development login; never accepted in production.
DEV_AUTH_ENABLED=false
