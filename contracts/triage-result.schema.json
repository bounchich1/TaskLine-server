{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:max-support:triage-result:1.1",
  "title": "Initial triage result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dictionary_version",
    "tags",
    "tip",
    "customer_reply",
    "evidence_message_ids",
    "evidence_memory_ids",
    "missing_information",
    "confidence",
    "needs_review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "dictionary_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "urgency",
        "complexity"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "urgency": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "complexity": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "tip": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "steps",
            "cautions"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "steps": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "case_refs"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "case_refs": {
                    "type": "array",
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  }
                }
              }
            },
            "cautions": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      ]
    },
    "customer_reply": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      ]
    },
    "evidence_message_ids": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 1
    },
    "evidence_memory_ids": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "missing_information": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_review": {
      "type": "boolean"
    }
  }
}
