{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:max-support:learning-completion:1",
  "title": "Closure agent completion after actual tool receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_receipt_id",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tool_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "accepted_pending_persistence",
        "persisted",
        "needs_review"
      ]
    }
  }
}
